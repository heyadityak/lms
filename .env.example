APP_NAME=LMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=secret

# API-only (D-43): Laravel keeps no sessions; the browser session is the Next.js BFF's encrypted cookie.
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
# Stateless processes: no local-disk state; all uploads on the shared s3 disk
FILESYSTEM_DISK=s3
# redis (default) or database (fallback; jobs/failed_jobs tables are kept)
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis: separate logical DBs so cache:clear never drops jobs (DB 2, the old session DB, is unused since D-43).
# Managed/TLS Redis: REDIS_SCHEME=tls, or REDIS_URL=tls://user:pass@host:6380
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_SCHEME=tcp
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=3
REDIS_PREFIX=lms-

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"

# Keycloak (identity provider + role authority). Passwords/reset live in Keycloak.
# BASE_URL = server back-channel (token, userinfo, JWKS); PUBLIC_URL = browser redirects + token issuer.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=lms
# First-party BFF client (Next.js `web`, D-43): its tokens pass `module:api`. The client secret is read only by `web`.
KEYCLOAK_CLIENT_ID=lms-web
# Secret; DEV value matches realm-lms.json. Regenerate per deployment.
KEYCLOAK_CLIENT_SECRET=lms-web-dev-secret
KEYCLOAK_ALLOWED_AUDIENCES=lms-web,lms-api-cli
KEYCLOAK_JWT_LEEWAY=30
KEYCLOAK_JWKS_CACHE_TTL=3600
# Service account for the Admin REST API (in-app user management, role admin, D-22/D-29). Secret; DEV value matches realm-lms.json.
KEYCLOAK_ADMIN_CLIENT_ID=lms-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=lms-admin-dev-secret
# Keycloak admin console bootstrap (compose only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Keycloak log level (compose only), e.g. info,org.keycloak.services:debug
KC_LOG_LEVEL=info

# Leave policy (ISO weekdays; 1 = January)
LMS_WEEKEND_DAYS=6,7
LEAVE_YEAR_START_MONTH=1
LMS_SL_MAX_BACKDATE_DAYS=7
# Multi-level approval (module multi_level_approval) sends requests of at least this many days to HR.
LEAVE_HR_APPROVAL_DAYS=5
# Pending requests older than this many days are escalated to HR (lms:escalate-stale-approvals).
LEAVE_ESCALATION_DAYS=3

# White-label defaults (admin overrides live in the settings table)
APP_BRAND_NAME="Leave Manager"
BRAND_PRIMARY_COLOR="#1f6feb"
BRAND_ACCENT_COLOR="#0e8a16"
# Licensed modules (ceiling an admin can toggle within).
# leave out user_management for LDAP/AD/Entra-backed realms (D-34)
# Add multi_level_approval to license HR approval of long requests.
MODULES_ENABLED=holidays,reports,api,notifications,user_management

# Branding asset disk: s3 (shared; required with >1 replica) or branding (local, single node only)
BRANDING_DISK=s3
# S3-compatible store. Dev: RustFS from compose (creds below also seed the RustFS server).
RUSTFS_ACCESS_KEY=lmsdev
RUSTFS_SECRET_KEY=lmsdevsecret
AWS_ACCESS_KEY_ID="${RUSTFS_ACCESS_KEY}"
AWS_SECRET_ACCESS_KEY="${RUSTFS_SECRET_KEY}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lms
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# App server (D-27). octane = FrankenPHP worker mode; classic = plain FrankenPHP (debugging state issues)
APP_SERVER_MODE=octane
OCTANE_SERVER=frankenphp
# Workers per replica (auto = CPU count); recycle each worker after N requests
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500
# FrankenPHP/Caddy's own log level (DEBUG|INFO|WARN|ERROR); INFO adds one access line per request. App logs use LOG_LEVEL.
CADDY_LOG_LEVEL=WARN
# Caddy site address; :8000 disables FrankenPHP auto-HTTPS (TLS ends at nginx / the LB)
SERVER_NAME=:8000

# Next.js frontend + BFF (`web`, D-43/D-45). Runtime env only; also uses APP_URL, KEYCLOAK_BASE_URL/REALM/CLIENT_*.
# Secret, >= 32 random bytes, identical on every web replica. DEV ONLY placeholder; generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
# Better Auth store (own database, not Laravel's `lms`; own DB user in prod). Secret (contains the password).
AUTH_DATABASE_URL=postgres://lms:secret@postgres:5432/lms_auth
# Internal URL of Laravel for the BFF + server components; through nginx so app replicas stay balanced.
LMS_API_URL=http://nginx
# Optional: Next fetch-cache TTL for GET /api/v1/branding (s); Better Auth session lifetime (s, <= Keycloak SSO Session Max)
BRANDING_REVALIDATE_SECONDS=30
AUTH_SESSION_MAX_AGE=36000
# Host port of `docker compose run --service-ports web-dev npm run dev` (tooling only)
WEB_DEV_PORT=3000

# nginx edge proxy (envsubst in docker/nginx/default.conf.template): HTTP upstreams of the app and web replicas
APP_UPSTREAM=app:8000
WEB_UPSTREAM=web:3000
# DNS resolver nginx uses to re-resolve APP_UPSTREAM/WEB_UPSTREAM (Docker: 127.0.0.11; k8s: kube-dns IP)
NGINX_RESOLVER=127.0.0.11
# Comma-separated proxy IPs/CIDRs or * (behind ingress)
TRUSTED_PROXIES=*
