{
  "realm": "lms",
  "enabled": true,
  "displayName": "Leave Manager",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 1,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "LMS base role: employee (apply for leave)"
      },
      {
        "name": "manager",
        "description": "LMS base role: manager (approves direct reports)"
      },
      {
        "name": "hr_admin",
        "description": "LMS base role: HR admin (departments, leave types, holidays, balances, reports)"
      },
      {
        "name": "admin",
        "description": "LMS additive role: branding, modules, Keycloak user management (D-29). Needs a base role too."
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-lms",
        "description": "Default roles: every new user is an employee",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "employee"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-lms"
  },
  "clients": [
    {
      "clientId": "lms-web",
      "name": "LMS web app",
      "description": "Next.js BFF client (auth code + PKCE S256, D-43). DEV ONLY: secret and localhost:8080 URIs; per deployment use ${APP_URL}/auth/*, ${APP_URL}, ${APP_URL}/ and a new secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lms-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/auth/*"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lms-api-cli",
      "name": "LMS API consumers",
      "description": "Public client for API consumers (auth code + PKCE, loopback redirect).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lms-dev-cli",
      "name": "DEV ONLY password-grant client",
      "description": "DEV ONLY. Direct access grants (password grant) for local smoke tests; tokens carry aud lms-api-cli so the API accepts them. Never import in production.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience lms-api-cli",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lms-api-cli",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lms-admin",
      "name": "LMS user administration (service account)",
      "description": "Confidential service-account client the LMS uses for the Keycloak Admin REST API (manage/view/query users only). Secret below is DEV ONLY; regenerate per deployment.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lms-admin-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "kc-admin-api"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Employee",
      "attributes": {
        "dev_only": [
          "true"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-lms",
        "employee"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Manager",
      "attributes": {
        "dev_only": [
          "true"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-lms",
        "manager"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "HR",
      "attributes": {
        "dev_only": [
          "true"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-lms",
        "hr_admin"
      ]
    },
    {
      "username": "dave",
      "enabled": true,
      "email": "dave@example.test",
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Admin",
      "attributes": {
        "dev_only": [
          "true"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-lms",
        "employee",
        "admin"
      ]
    },
    {
      "username": "service-account-lms-admin",
      "enabled": true,
      "serviceAccountClientId": "lms-admin",
      "realmRoles": [],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@example.test",
    "fromDisplayName": "Leave Manager",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  }
}
