log_format lms '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
               'rid=$request_id upstream=$upstream_addr rt=$request_time';

server {
    listen 80 default_server;
    server_name _;
    root /var/www/html/public;
    index index.php;

    server_tokens off;

    # Re-resolve the php-fpm service name so scaled replicas (and replaced ones) are
    # picked up; nginx round-robins across all returned A records. No sticky sessions.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $php_upstream ${PHP_FPM_HOST};
    client_max_body_size 8m;
    charset utf-8;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /dev/stdout lms;
    error_log /dev/stderr warn;

    # nginx container's own healthcheck
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; try_files $uri /index.php?$query_string; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass $php_upstream;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        fastcgi_param HTTP_X_REQUEST_ID $request_id;
        fastcgi_hide_header X-Powered-By;
        internal;
    }

    # Any other .php file is never executed.
    location ~ \.php$ { return 404; }

    location ~ /\.(?!well-known) { deny all; }
}
