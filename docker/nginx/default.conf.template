# Edge reverse proxy + load balancer in front of N FrankenPHP/Octane replicas (D-24, D-27). No FastCGI.
log_format lms '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
               'rid=$request_id upstream=$upstream_addr rt=$request_time';

# Re-resolve APP_UPSTREAM so `--scale app=N` (and replaced replicas) are picked up; round-robin, no sticky sessions.
resolver ${NGINX_RESOLVER} valid=5s ipv6=off;

upstream app {
    zone app 64k;
    server ${APP_UPSTREAM} resolve;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    client_max_body_size 8m;
    charset utf-8;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /dev/stdout lms;
    error_log /dev/stderr warn;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Static files from public/ (baked into the image); everything else goes to the app.
    location / {
        try_files $uri @app;
    }

    # PHP is never served as a file.
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }

    location @app {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # $http_host keeps the client's port (e.g. :8080), so Laravel builds correct URLs.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Request-Id $request_id;
        proxy_hide_header X-Powered-By;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_read_timeout 60s;
    }
}
