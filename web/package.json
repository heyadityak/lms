{
    "name": "lms-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "node .next/standalone/server.js",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "e2e": "playwright test --config e2e/playwright.config.ts",
        "gen:api": "openapi-typescript ../docs/api/openapi.yaml -o src/lib/api/schema.d.ts",
        "check:api": "openapi-typescript ../docs/api/openapi.yaml -o src/lib/api/schema.d.ts --check",
        "auth:migrate": "node scripts/auth-migrate.mjs"
    },
    "dependencies": {
        "@ant-design/cssinjs": "2.1.2",
        "@ant-design/icons": "6.3.4",
        "@ant-design/nextjs-registry": "1.3.0",
        "@tanstack/react-query": "5.108.0",
        "antd": "6.7.1",
        "better-auth": "1.7.26",
        "dayjs": "1.11.23",
        "next": "16.4.6",
        "openapi-fetch": "0.17.0",
        "pg": "8.23.1",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "1.65.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "24.19.2",
        "@types/pg": "8.23.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.6",
        "jsdom": "31.0.1",
        "openapi-typescript": "7.13.0",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "vitest": "5.1.1"
    }
}
